[
  {
    "id": "tab_gas",
    "type": "tab",
    "label": "Smart Waste Bin - Gas",
    "disabled": false,
    "info": "Gas alert flow: subscribe to gas -> when 'detected' -> build an alert ->\nfan out to BOTH an MQTT topic (mqtt out) AND the REST API (http request)."
  },

  {
    "id": "broker_cfg",
    "type": "mqtt-broker",
    "name": "Broker",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "node-red-smartbin-gas",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },

  {
    "id": "mqtt_in_gas",
    "type": "mqtt in",
    "z": "tab_gas",
    "name": "gas state",
    "topic": "smartbin/+/+/gas",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_cfg",
    "nl": false, "rap": true, "rh": 0,
    "x": 130, "y": 160,
    "wires": [["filter_detected"]]
  },
  {
    "id": "filter_detected",
    "type": "switch",
    "z": "tab_gas",
    "name": "is 'detected'?",
    "property": "payload", "propertyType": "msg",
    "rules": [{ "t": "eq", "v": "detected", "vt": "str" }],
    "checkall": "true", "repair": false, "outputs": 1,
    "x": 330, "y": 160,
    "wires": [["delay_1s"]]
  },
  {
    "id": "delay_1s",
    "type": "delay",
    "z": "tab_gas",
    "name": "delay 1s",
    "pauseType": "delay",
    "timeout": "1", "timeoutUnits": "seconds",
    "rate": "1", "rateUnits": "second",
    "randomFirst": "1", "randomLast": "5", "randomUnits": "seconds",
    "drop": false,
    "x": 510, "y": 160,
    "wires": [["build_alert"]]
  },
  {
    "id": "build_alert",
    "type": "function",
    "z": "tab_gas",
    "name": "build alert",
    "func": "const parts = (msg.topic || \"\").split(\"/\");\nconst binId = parts[1] || \"bin-01\";\nconst alert = {\n    bin_id: binId,\n    type: \"gas\",\n    severity: \"critical\",\n    message: \"Gas detected at \" + binId,\n    ts: new Date().toISOString()\n};\nmsg.topic = \"smartbin/\" + binId + \"/alert\";\nmsg.payload = JSON.stringify(alert);\nreturn msg;\n",
    "outputs": 1, "noerr": 0, "initialize": "", "finalize": "", "libs": [],
    "x": 700, "y": 160,
    "wires": [["mqtt_out_alert", "prep_api", "debug_alert"]]
  },

  {
    "id": "mqtt_out_alert",
    "type": "mqtt out",
    "z": "tab_gas",
    "name": "MQTT out (alert)",
    "topic": "", "qos": "1", "retain": "false",
    "broker": "broker_cfg",
    "x": 940, "y": 100,
    "wires": []
  },

  {
    "id": "prep_api",
    "type": "function",
    "z": "tab_gas",
    "name": "prep API body",
    "func": "// Build the body the REST API expects: POST /mqtt/publish\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = {\n    topic: msg.topic,\n    payload: msg.payload,\n    qos: 1,\n    retain: false\n};\nreturn msg;\n",
    "outputs": 1, "noerr": 0, "initialize": "", "finalize": "", "libs": [],
    "x": 910, "y": 240,
    "wires": [["http_api"]]
  },
  {
    "id": "http_api",
    "type": "http request",
    "z": "tab_gas",
    "name": "API (POST)",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://localhost:5000/mqtt/publish",
    "persist": false,
    "authType": "",
    "x": 1110, "y": 240,
    "wires": [["debug_api"]]
  },

  {
    "id": "debug_alert",
    "type": "debug",
    "z": "tab_gas",
    "name": "alert out",
    "active": true, "tosidebar": true, "console": false,
    "complete": "payload", "targetType": "msg",
    "x": 940, "y": 160, "wires": []
  },
  {
    "id": "debug_api",
    "type": "debug",
    "z": "tab_gas",
    "name": "API response",
    "active": true, "tosidebar": true, "console": false,
    "complete": "payload", "targetType": "msg",
    "x": 1310, "y": 240, "wires": []
  }
]
