{
  "@context": {
    "@version": 1.1,
    "schema": "https://schema.org/",
    "sosa": "http://www.w3.org/ns/sosa/",
    "ssn": "http://www.w3.org/ns/ssn/",
    "qudt": "http://qudt.org/schema/qudt/",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#",
    "smartbin": "urn:smartbin:vocab#",

    "id": "@id",
    "type": "@type",

    "name": "schema:name",
    "description": "schema:description",
    "location": "schema:location",
    "status": "smartbin:status",
    "model": "schema:model",

    "Wastebin": "smartbin:Wastebin",
    "Sensor": "sosa:Sensor",
    "Environment": "smartbin:Environment",
    "Observation": "sosa:Observation",

    "madeBySensor": {"@id": "sosa:madeBySensor", "@type": "@id"},
    "observedProperty": {"@id": "sosa:observedProperty", "@type": "@id"},
    "hasSimpleResult": "sosa:hasSimpleResult",
    "resultTime": {"@id": "sosa:resultTime", "@type": "schema:DateTime"},

    "mounted_on": {"@id": "smartbin:mountedOn", "@type": "@id"},
    "deployedIn": {"@id": "smartbin:deployedIn", "@type": "@id"},
    "monitors": {"@id": "smartbin:monitors", "@type": "@id"},

    "latitude": "geo:lat",
    "longitude": "geo:long",
    "capacity_liters": "smartbin:capacityLiters",
    "fill_threshold_pct": "smartbin:fillThresholdPct"
  }
}
