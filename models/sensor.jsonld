{
  "@context": "context.jsonld",
  "@type": "schema:Collection",
  "name": "Smart Waste Bin Sensor Registry",
  "sensors": [
    {
      "id": "pir-01",
      "type": "Sensor",
      "name": "PIR Motion Sensor (Kitchen Bin)",
      "model": "HC-SR501",
      "mounted_on": "bin-01",
      "status": "online",
      "observedProperty": "smartbin:motion",
      "deployedIn": "env-lab-101"
    },
    {
      "id": "pir-02",
      "type": "Sensor",
      "name": "PIR Motion Sensor (Hallway Bin)",
      "model": "HC-SR501",
      "mounted_on": "bin-02",
      "status": "online",
      "observedProperty": "smartbin:motion",
      "deployedIn": "env-lab-101"
    },
    {
      "id": "vs-usage-01",
      "type": "Sensor",
      "name": "Virtual Usage-Intensity Sensor (Kitchen Bin)",
      "model": "rule-based-v1",
      "mounted_on": "bin-01",
      "status": "online",
      "observedProperty": "smartbin:usageIntensity",
      "deployedIn": "env-lab-101"
    },
    {
      "id": "vs-predict-01",
      "type": "Sensor",
      "name": "Virtual Busy-Period Predictor (Kitchen Bin)",
      "model": "RandomForestClassifier-v1",
      "mounted_on": "bin-01",
      "status": "online",
      "observedProperty": "smartbin:busyPrediction",
      "deployedIn": "env-lab-101"
    }
  ]
}
